# Copy this file to backend/.env (local development) or .env (Docker Compose)
# and fill in the blanks. Never commit the real .env file.

# development | production
ENV=development
# Exact public URL of the site, no trailing slash.
# Local dev: http://localhost:5173   Production: https://your-app.onrender.com
APP_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://shahmaat:shahmaat@localhost:5432/shahmaat
REDIS_URL=redis://localhost:6379/0

# Two DIFFERENT long random strings (32+ characters). Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
REFRESH_TOKEN_SECRET=

# chess.com asks API users to identify themselves (your email or site URL)
CHESSCOM_CONTACT=you@example.com
# true behind Render or any reverse proxy, so rate limits see real client IPs
TRUST_PROXY=false
# true only when running 2+ app instances behind a load balancer
MULTI_INSTANCE=false
LOG_LEVEL=INFO

# Optional: "Continue with Google" (set both or neither)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: protects /metrics (Prometheus) in production
METRICS_TOKEN=
